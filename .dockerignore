# File này quyết định thứ KHÔNG được copy vào image.
# Bỏ sót .env = leak secret vào image. Bỏ sót .git = image phình to.
# Lưu ý: KHÔNG ignore app/, utils/, requirements.txt — image cần chúng.

# Secret
.env
.env.*

# Git
.git
.gitignore
.github

# Môi trường ảo & cache Python
.venv
venv
__pycache__
*.pyc
*.pyo
.pytest_cache
.mypy_cache
.ruff_cache

# Không cần trong image runtime
tests
screenshots
nginx
*.md
docker-compose.yml
railway.toml
render.yaml
grade.py

# IDE / OS
.vscode
.idea
.DS_Store
Thumbs.db
